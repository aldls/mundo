<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Dashboard</title>
  <link rel="stylesheet" href="dashboard.css">
</head>
<body>
  <div class="container">
    <div class="background-overlay"></div>
    <div class="left-side">
      <h1><%= user.nickname %> 님,<br>문도박사의 피구장에<br>오신 것을 환영합니다</h1>
      <div class="button-container">
        <button class="play-button" onclick="window.location.href='<%= gameUrl %>'">게임 시작</button>
        <button class="play-button" onclick="window.location.href='/leaderboard'">장인 랭킹</button>
      </div>
    </div>
  
    <div class="right-side">
      <h2><%= user.nickname %></h2>
      <img src="<%= user.photo %>" class="profile-photo" />
      <p><strong>게임 수:</strong> <%= user.wins + user.losses %></p>
      <p><%= user.wins %><strong>승 </strong><%= user.losses %><strong>패</strong></p>

  
      <form action="/logout" method="get" onsubmit="return confirm('로그아웃하시겠습니까?')">
        <button class="logout-button" type="submit">로그아웃</button>
      </form>
  
      <form action="/delete-account" method="POST" onsubmit="return confirm('계정을 정말 삭제하시겠습니까? 이 행동은 되돌릴 수 없습니다.')">
        <button class="delete-button" type="submit">계정 탈퇴</button>
      </form>
    </div>
    
    <div class="gif-container">
      <img src="mundo_throwing.gif" alt="Mundo Throwing" class="gif-image" />
    </div>

  </div>  
  
</body>
</html>

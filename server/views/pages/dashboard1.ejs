<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Dashboard</title>
  <link rel="stylesheet" href="dashboard.css">
</head>
<body>
  <div class="background-overlay"></div> <!-- Shared black rectangle -->
  <div class="container">
    <div class="background-overlay"></div> <!-- Shared black rectangle -->
    <!-- Left Side: Welcome message and buttons -->
    <div class="left-side">
      <h1><%= user.nickname %> 님,<br>문도박사의 피구장에<br>오신 것을 환영합니다</h1>

      <img src=<%= user.photo %> class="profile-photo" />
      <p><strong>Level:</strong> <%= user.level %></p>
      <h2><%= user.nickname %></h2> <!-- Display nickname or fallback to 'User Profile' -->
      <!-- Logout Button -->
      <form action="/logout" method="get" onsubmit="return confirm('로그아웃하시겠습니까?')">
        <button class="logout-button" type="submit" style="color: #C89B3C;">로그아웃</button>
      </form>
      
      <form action="/delete-account" method="POST" onsubmit="return confirm('계정을 정말 삭제하시겠습니까? 이 행동은 되돌릴 수 없습니다.')">
        <button class="delete-button" type="submit" style="color: red;">  계정 탈퇴</button>
      </form>
    </div>

    <!-- Right Side with GIF -->
    <div class="right-side">
      <img src="mundo_throwing.gif" alt="Mundo Throwing" class="gif-image" />
    </div>
    
  </div>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Leaderboard</title>
  <link rel="stylesheet" href="/leaderboard.css">
</head>
<body>
  <!-- Replace h1 with image -->
  <img src="leaderboard.png" alt="Leaderboard" class="leaderboard-logo" />
  
  <!-- Button with Image -->
  <a href="/dashboard">
    <button id="goBack" class="goBack">
      <span class="button-text">돌아가기</span>
      <img src="msg.png" alt="Message Button" class="button-image">
    </button>
  </a>

  <!-- Sorting Buttons -->
  <div class="sorting-buttons">
    <button onclick="sortLeaderboard('wins', 'desc')">승리</button>
    <button onclick="sortLeaderboard('winrate', 'desc')">승률</button>
    <button onclick="sortLeaderboard('losses', 'asc')">패배</button>
    <button onclick="sortLeaderboard('nickname', 'desc')">닉네임(오름차순)</button>
    <button onclick="sortLeaderboard('nickname', 'asc')">닉네임(내림차순)</button>
  </div>

  <!-- Leaderboard Table -->
  <table>
    <thead>
      <tr>
        <th>순위</th>
        <th>닉네임</th>
        <th>승리</th>
        <th>패배</th>
        <th>승률</th>
      </tr>
    </thead>
    <tbody>
      <% players.forEach((player, index) => { %>
        <tr>
          <td><%= index + 1 %></td>
          <td><%= player.nickname %></td>
          <td><%= player.wins %></td>
          <td><%= player.losses %></td>
          <td><%= Math.round((player.wins / (player.losses + player.wins)) * 100) / 100 %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <script>
    // JavaScript function to trigger sorting
    function sortLeaderboard(field, order) {
      const url = `/leaderboard?sortBy=${field}&order=${order}`;
      window.location.href = url; // Navigate to the sorted leaderboard
    }
  </script>
</body>
</html>
